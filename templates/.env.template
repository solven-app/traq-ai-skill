# TRAQ AI Skill — .env Template

# Copy this file to your project root as `.env` and fill in the values.
# The traq-ai-skill installer (npx traq-ai-skill) will fill these automatically.

# ──────────────────────────────────────────────────────────────
# Required: TRAQ server base URL
# Examples:
#   Local:  http://localhost:3001
#   Hosted: https://traq.yourdomain.com
# ──────────────────────────────────────────────────────────────
TRAQ_API_URL=http://localhost:3001

# ──────────────────────────────────────────────────────────────
# Required: Your TRAQ API key
# Generate one: TRAQ Settings → API Management → Generate Key
# IMPORTANT: Copy it immediately — it is only shown once.
# Activate the key and enable permissions before use.
# ──────────────────────────────────────────────────────────────
TRAQ_API_KEY=traq_your_key_here
